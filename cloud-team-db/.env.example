# PostgreSQL 17 Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=ctm
DATABASE_URL=postgresql://postgres:replace-with-random-hex@localhost:5432/ctm

# Bootstrap Admin Account (used by db:seed when no active admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-initial-password
