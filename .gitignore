# dependencies
node_modules/
cloud-team-db/node_modules/
cloud-team-backend/node_modules/
cloud-team-frontend/node_modules/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example
cloud-team-db/.env*
!cloud-team-db/.env.example
cloud-team-backend/.env*
!cloud-team-backend/.env.example
cloud-team-frontend/.env*
!cloud-team-frontend/.env.example

# deployment and generated files
dist/
cloud-team-backend/dist/
cloud-team-frontend/dist/

# local dev/test uploads
attachments-dev/
attachments/*
!attachments/.gitkeep
cloud-team-backend/attachments-dev/
cloud-team-backend/attachments/*
!cloud-team-backend/attachments/.gitkeep

# worktrees and superpowers
.worktrees
.worktrees/
.superpowers
.superpowers/
