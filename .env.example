# Public domain pointed at this server (Caddy provisions HTTPS for it).
# For a local HTTP-only trial use  DOMAIN=:8080
DOMAIN=team.example.com
PORT=3000

# Postgres database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ctm
POSTGRES_TEST_DB=ctm_test

# Session & security configuration
SESSION_SECRET=change-me-long-random-2
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
JSON_BODY_LIMIT=256kb

# First admin account, created on first boot if no active admin exists
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong

# Attachments & file upload limits (25 MB for docs/attachments, 15 MB for Copilot)
ATTACHMENTS_DIR=./attachments-dev
MAX_ATTACHMENT_BYTES=26214400
MAX_COPILOT_FILE_BYTES=15728640

# AI Copilot (optional — leave blank to keep the Copilot disabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COPILOT_SNAPSHOT_BUDGET=1000000
