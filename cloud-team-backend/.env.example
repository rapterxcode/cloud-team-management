# Backend API Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://localhost
JSON_BODY_LIMIT=256kb

# External PostgreSQL Connection (cloud-team-db or Managed DB)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=ctm
POSTGRES_TEST_DB=ctm_test
DATABASE_URL=postgresql://postgres:replace-with-random-hex@127.0.0.1:5432/ctm

# Authentication & Session Security
SESSION_SECRET=replace-with-another-random-hex
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-initial-password

# Local Attachment Storage
ATTACHMENTS_DIR=./attachments
MAX_ATTACHMENT_BYTES=26214400
MAX_COPILOT_FILE_BYTES=15728640

# AI Copilot (Gemini 3.8 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COPILOT_SNAPSHOT_BUDGET=1000000
